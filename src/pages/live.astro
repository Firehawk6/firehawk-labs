---
import ContentLayout from '../layouts/ContentLayout.astro';
---
<ContentLayout title="Hang out live." intro="Games, projects, and whatever happens next. This is my little corner of Twitch, right here in Labs.">
  <section class="stream" aria-label="tezzzzaa on Twitch">
    <header>
      <div><p class="handle">TWITCH / TEZZZZAA</p><h2 id="twitch-title">Welcome to the stream.</h2><p id="twitch-detail">Checking the channel…</p></div>
      <span id="twitch-status" role="status">CHECKING STATUS</span>
    </header>
    <div class="watch-grid">
      <div class="video-wrap" id="twitch-video-wrap">
        <iframe id="twitch-player" title="tezzzzaa Twitch livestream" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen hidden></iframe>
        <div id="twitch-small" class="small-screen" hidden><p>Open Twitch to watch on this screen size.</p><a href="https://www.twitch.tv/tezzzzaa" target="_blank" rel="noopener noreferrer">Watch tezzzzaa ↗</a></div>
        <noscript><p>Enable JavaScript to load the Twitch player, or use the channel link below.</p></noscript>
      </div>
      <aside><div class="chat-heading">STREAM CHAT</div><iframe id="twitch-chat" title="tezzzzaa Twitch chat" loading="lazy"></iframe></aside>
    </div>
    <footer><span>Make yourself at home.</span><a href="https://www.twitch.tv/tezzzzaa" target="_blank" rel="noopener noreferrer">Open channel on Twitch ↗</a></footer>
  </section>
  <p class="detail-copy">Press play to watch. If Twitch is blocked by your browser or the player won’t load, use the channel link above. Chat sign-in is handled by Twitch.</p>
</ContentLayout>
<script>
  import '../scripts/twitch-status.js';
  const player = document.getElementById('twitch-player') as HTMLIFrameElement;
  const chat = document.getElementById('twitch-chat') as HTMLIFrameElement;
  const wrap = document.getElementById('twitch-video-wrap')!;
  const small = document.getElementById('twitch-small')!;
  const parent = window.location.hostname;
  const playerURL = new URL('https://player.twitch.tv/');
  playerURL.search = new URLSearchParams({channel:'tezzzzaa', parent, autoplay:'false', muted:'false'}).toString();
  const chatURL = new URL('https://www.twitch.tv/embed/tezzzzaa/chat');
  chatURL.search = new URLSearchParams({parent, darkpopout:''}).toString();
  chat.src = chatURL.href;
  new ResizeObserver(() => {
    const fits = wrap.clientWidth >= 400;
    player.hidden = !fits; small.hidden = fits;
    if (fits && !player.hasAttribute('src')) player.src = playerURL.href;
    if (!fits) player.removeAttribute('src');
  }).observe(wrap);
</script>
<style>
.stream{border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--panel)}header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;padding:24px}.handle{color:var(--accent);font-size:.75rem;letter-spacing:.12em;margin:0 0 10px}h2{font-size:clamp(1.3rem,2.5vw,2rem);margin:0;max-width:950px}#twitch-detail{margin:10px 0 0;color:var(--muted);font:.9rem/1.6 Arial,sans-serif}#twitch-status{font-size:.7rem;letter-spacing:.08em;color:var(--muted);padding:8px 12px;border:1px solid var(--border);border-radius:20px}#twitch-status[data-live=true]{color:var(--accent);border-color:var(--accent);background:#281b1e}.watch-grid{display:grid;grid-template-columns:minmax(400px,1fr) 340px;border-top:1px solid var(--border)}.video-wrap{min-width:0;background:#0b0b0d;display:flex;align-items:center}#twitch-player{width:100%;aspect-ratio:16/9;min-height:300px;border:0;display:block}#twitch-player[hidden],.small-screen[hidden]{display:none}.small-screen{padding:40px 24px;color:var(--muted)}.small-screen a{color:var(--accent)}aside{display:flex;flex-direction:column;border-left:1px solid var(--border);min-height:450px}.chat-heading{padding:12px 16px;color:var(--muted);font-size:.7rem;letter-spacing:.1em;border-bottom:1px solid var(--border)}#twitch-chat{width:100%;flex:1;min-height:400px;border:0}footer{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:18px 24px;border-top:1px solid var(--border);font-size:.8rem;color:var(--muted)}footer a{color:var(--accent);text-underline-offset:4px}.detail-copy{margin-top:24px}@media(max-width:1000px){.watch-grid{grid-template-columns:minmax(0,1fr)}aside{border-left:0;border-top:1px solid var(--border);height:460px}}
</style>
