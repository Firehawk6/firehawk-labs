---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/home/TopBar.astro";
import Terminal from "../components/terminal/Terminal.astro";
---

<BaseLayout title="Terminal | Firehawk Labs">
    <div class="page">

        <TopBar />

        <main>

            <section class="hero">

                <p class="eyebrow">
                    > FIREHAWK TERMINAL
                </p>

                <h1>
                    Command Interface
                </h1>

                <p>
                    Navigate Firehawk Labs using commands.
                    This terminal will eventually control the
                    entire website.
                </p>

            </section>

            <Terminal />

        </main>

    </div>
</BaseLayout>

<style>

.page{

    width:min(1200px,calc(100% - 48px));
    margin:auto;

}

main{

    padding:90px 0 120px;

}

.hero{

    margin-bottom:50px;

}

.eyebrow{

    color:var(--green);
    letter-spacing:.12em;
    font-size:.72rem;

}

h1{

    margin:.5rem 0;
    font-size:clamp(3rem,7vw,5rem);

}

.hero p:last-child{

    max-width:650px;
    color:var(--muted);
    line-height:1.8;

}

</style>
