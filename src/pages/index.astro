---
const projects = [
  {
    title: "Homelab",
    description:
      "Servers, networking, virtualization, storage, and the mildly irresponsible amount of hardware behind it all.",
    tag: "INFRASTRUCTURE",
  },
  {
    title: "Minecraft Network",
    description:
      "Custom servers, routing, proxies, mods, and the chaos required to keep everything online.",
    tag: "GAME SYSTEMS",
  },
  {
    title: "Security Lab",
    description:
      "Isolated environments for testing tools, policies, endpoints, and security ideas.",
    tag: "CYBERSECURITY",
  },
  {
    title: "Web Experiments",
    description:
      "Animations, interfaces, mouse effects, odd interactions, and ideas that probably did not need to exist.",
    tag: "CREATIVE CODE",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A collection of projects, experiments, and strange ideas."
    />
    <title>Firehawk Labs</title>
  </head>

  <body>
    <div class="cursor-glow"></div>
    <div class="scanlines"></div>

    <main>
      <nav>
        <div class="logo">FIREHAWK_LABS</div>

        <div class="nav-links">
          <a
            href="https://github.com/Firehawk6"
            target="_blank"
            rel="noopener noreferrer"
          >
            GITHUB ↗
          </a>

          <a href="#projects">PROJECTS</a>

          <div class="status">SYSTEM ONLINE</div>
        </div>
      </nav>

      <section class="hero">
        <p class="eyebrow">&gt; INITIALIZING PROJECT ARCHIVE...</p>

        <h1>
          I build things
          <span>because I can.</span>
        </h1>

        <p class="intro">
          A collection of homelab projects, experiments, websites,
          infrastructure, automation, and assorted questionable ideas.
        </p>

        <div class="hero-actions">
          <a href="#projects" class="enter-button">
            VIEW PROJECTS
            <span>↘</span>
          </a>

          <a
            href="https://github.com/Firehawk6"
            target="_blank"
            rel="noopener noreferrer"
            class="secondary-button"
          >
            OPEN GITHUB
            <span>↗</span>
          </a>
        </div>
      </section>

      <section class="projects-section" id="projects">
        <div class="section-heading">
          <p>DIRECTORY / PROJECTS</p>
          <span>04 ITEMS FOUND</span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <article class="project-card">
                <div class="card-number">
                  {String(index + 1).padStart(2, "0")}
                </div>

                <div class="card-content">
                  <p class="tag">{project.tag}</p>
                  <h2>{project.title}</h2>
                  <p>{project.description}</p>
                </div>

                <div class="card-arrow">↗</div>
              </article>
            ))
          }
        </div>
      </section>

      <footer>
        <div>
          <p>FIREHAWK_LABS</p>
          <span>PROJECT ARCHIVE / DIGITAL PLAYGROUND</span>
        </div>

        <a
          href="https://github.com/Firehawk6"
          target="_blank"
          rel="noopener noreferrer"
        >
          github.com/Firehawk6 ↗
        </a>
      </footer>
    </main>

    <script>
      const glow = document.querySelector(".cursor-glow");

      window.addEventListener("mousemove", (event) => {
        if (!(glow instanceof HTMLElement)) return;

        glow.style.left = `${event.clientX}px`;
        glow.style.top = `${event.clientY}px`;
      });
    </script>
  </body>
</html>

<style>
  :root {
    --background: #070908;
    --panel: #0d1210;
    --panel-hover: #121a16;
    --border: #203028;
    --text: #e4eee8;
    --muted: #7d9185;
    --green: #6dff9b;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    background:
      linear-gradient(rgba(109, 255, 155, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(109, 255, 155, 0.025) 1px, transparent 1px),
      var(--background);
    background-size: 48px 48px;
    color: var(--text);
    font-family:
      "Courier New",
      Courier,
      monospace;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(109, 255, 155, 0.08),
        transparent 34%
      ),
      linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.45));
  }

  main {
    position: relative;
    z-index: 2;
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 82px;
    border-bottom: 1px solid var(--border);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }

  .logo {
    color: var(--green);
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    transition:
      color 180ms ease,
      text-shadow 180ms ease;
  }

  .nav-links a:hover {
    color: var(--green);
    text-shadow: 0 0 12px rgba(109, 255, 155, 0.45);
  }

  .status {
    color: var(--muted);
  }

  .status::before {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 12px var(--green);
  }

  .hero {
    display: flex;
    min-height: calc(100vh - 82px);
    flex-direction: column;
    justify-content: center;
    padding: 100px 0;
  }

  .eyebrow {
    margin-bottom: 28px;
    color: var(--green);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3.4rem, 9vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.075em;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1px var(--muted);
  }

  .intro {
    max-width: 680px;
    margin: 40px 0;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .enter-button,
  .secondary-button {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 40px;
    padding: 18px 22px;
    text-decoration: none;
    letter-spacing: 0.08em;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .enter-button {
    border: 1px solid var(--green);
    color: var(--green);
  }

  .enter-button:hover {
    background: var(--green);
    color: var(--background);
    box-shadow: 0 0 30px rgba(109, 255, 155, 0.18);
  }

  .secondary-button {
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .secondary-button:hover {
    border-color: var(--green);
    color: var(--green);
    box-shadow: 0 0 30px rgba(109, 255, 155, 0.1);
  }

  .projects-section {
    padding: 100px 0 140px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }

  .project-card {
    position: relative;
    min-height: 300px;
    overflow: hidden;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: rgba(13, 18, 16, 0.72);
    transition:
      transform 220ms ease,
      background 220ms ease;
  }

  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateY(101%);
    background: linear-gradient(
      180deg,
      transparent,
      rgba(109, 255, 155, 0.08)
    );
    transition: transform 260ms ease;
  }

  .project-card:hover {
    z-index: 3;
    transform: translateY(-6px);
    background: var(--panel-hover);
  }

  .project-card:hover::before {
    transform: translateY(0);
  }

  .card-number {
    position: absolute;
    top: 24px;
    left: 24px;
    color: var(--green);
    font-size: 0.76rem;
  }

  .card-content {
    position: absolute;
    right: 30px;
    bottom: 30px;
    left: 30px;
  }

  .tag {
    margin-bottom: 15px;
    color: var(--green);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .card-content h2 {
    margin: 0 0 15px;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: -0.06em;
    text-transform: uppercase;
  }

  .card-content p:last-child {
    max-width: 500px;
    margin: 0;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
  }

  .card-arrow {
    position: absolute;
    top: 20px;
    right: 24px;
    color: var(--muted);
    font-size: 1.4rem;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .project-card:hover .card-arrow {
    transform: translate(3px, -3px);
    color: var(--green);
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding: 34px 0 44px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  footer p {
    margin: 0 0 8px;
    color: var(--green);
  }

  footer span {
    display: block;
  }

  footer a {
    color: var(--muted);
    text-decoration: none;
    transition:
      color 180ms ease,
      text-shadow 180ms ease;
  }

  footer a:hover {
    color: var(--green);
    text-shadow: 0 0 12px rgba(109, 255, 155, 0.45);
  }

  .cursor-glow {
    position: fixed;
    z-index: 1;
    width: 440px;
    height: 440px;
    pointer-events: none;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(109, 255, 155, 0.09),
      transparent 68%
    );
  }

  .scanlines {
    position: fixed;
    z-index: 10;
    inset: 0;
    pointer-events: none;
    opacity: 0.14;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255, 255, 255, 0.025) 4px
    );
  }

  @media (max-width: 720px) {
    main {
      width: min(100% - 24px, 1180px);
    }

    .nav-links {
      gap: 14px;
    }

    .nav-links > a:nth-child(2),
    .status {
      display: none;
    }

    .hero {
      min-height: auto;
      padding: 110px 0;
    }

    h1 {
      font-size: clamp(3rem, 17vw, 5.5rem);
    }

    .hero-actions {
      flex-direction: column;
    }

    .enter-button,
    .secondary-button {
      justify-content: space-between;
      width: 100%;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .section-heading span {
      display: none;
    }

    footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .cursor-glow {
      display: none;
    }
  }
</style>
