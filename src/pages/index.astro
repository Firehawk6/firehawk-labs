---
import BaseLayout from "../layouts/BaseLayout.astro";
import TwitchLink from "../components/TwitchLink.astro";
import DesktopLauncher from "../components/DesktopLauncher.astro";
import TopBar from "../components/home/TopBar.astro";
import VisitorGlobe from "../components/VisitorGlobe.astro";
import Window from "../components/ui/Window.astro";
import { projects } from "../data/projects";

const getWindowStatus = (
  status: "online" | "development" | "archived"
): "online" | "warning" | "offline" => {
  if (status === "online") return "online";
  if (status === "archived") return "offline";

  return "warning";
};
---

<BaseLayout title="Firehawk Labs">
  <div class="system-shell">
    <TopBar />

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">&gt; CONNECTED TO FIREHAWK-LABS</p>

          <h1>
            BUILDING
            <span>WHAT I WANT.</span>
          </h1>

          <p class="intro">
            A place for my projects, the things I’m learning, and whatever I decide to build next.
          </p>

          <div class="hero-actions">
            <a class="primary-action" href="/projects">
              VIEW PROJECTS
            </a>

            <a class="secondary-action" href="/terminal">
              LAUNCH TERMINAL
            </a>
          </div>
          <TwitchLink />
        </div>

        <aside class="system-panel">
          <VisitorGlobe />
        </aside>
      </section>

      <DesktopLauncher />

      <section class="workspace" id="projects">
        <div class="workspace-heading">
          <div>
            <p class="eyebrow">DIRECTORY / PROJECTS</p>
            <h2>ON THE WORKBENCH</h2>
          </div>

          <span>
            {String(projects.length).padStart(2, "0")} {projects.length === 1 ? "PROJECT" : "PROJECTS"}
          </span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <a
                class="project-link"
                href={`/projects/${project.slug}`}
                aria-label={`Open ${project.title}`}
              >
                <Window
                  title={`PROJECT_${String(index + 1).padStart(3, "0")}`}
                  status={getWindowStatus(project.status)}
                >
                  <div class="project-content">
                    <div class="project-index">
                      {String(index + 1).padStart(2, "0")}
                    </div>

                    <p class="category">{project.category}</p>

                    <h3>{project.title}</h3>

                    <p class="description">
                      {project.description}
                    </p>

                    <div class="project-meta">
                      <span>
                        STATUS: {project.status.toUpperCase()}
                      </span>

                      <span>VIEW PROJECT ↗</span>
                    </div>
                  </div>
                </Window>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <span>FIREHAWK LABS / BUILT MY WAY</span>
      <span>labs.firehawk6.com</span>
    </footer>
  </div>


  <script>
    import gsap from "gsap";

    let animated = false;
    const animateInterface = () => {
      if (animated || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      animated = true;
      gsap.from(".hero-copy, .system-panel, .desktop-launcher", {
        opacity: 0, y: 14, duration: 0.45, stagger: 0.08, ease: "power2.out", clearProps: "all",
      });
    };
    window.addEventListener("firehawk:entered", animateInterface, { once: true });
    try {
      if (sessionStorage.getItem("firehawk-booted") === "true") animateInterface();
    } catch { animateInterface(); }

  </script>
</BaseLayout>

<style>

.system-shell { position:relative;z-index:2;width:min(var(--content-width),calc(100% - var(--gutter) * 2));margin:auto; }
.hero { display:grid;grid-template-columns:minmax(0,1.6fr) minmax(260px,1fr);gap:clamp(32px,5vw,72px);align-items:center;padding:var(--section-space) 0; }
.eyebrow,.category { color:var(--accent);font-size:.75rem;letter-spacing:.12em;margin:0; }
h1 { margin:22px 0 0;font-size:clamp(2.5rem,5.4vw,4.6rem);line-height:1.03;letter-spacing:-.065em; }
h1 span { display:block;color:var(--accent); }
.intro { max-width:540px;margin:26px 0 0;color:var(--muted);font-family:Arial,Helvetica,sans-serif;font-size:1.08rem;line-height:1.75; }
.hero-actions { display:flex;flex-wrap:wrap;gap:12px;margin-top:30px; }
.hero-actions a { display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:12px 18px;border:1px solid var(--border);font-size:.75rem;letter-spacing:.06em;text-decoration:none;transition:background 160ms,border-color 160ms; }
.primary-action { background:var(--accent);color:var(--background);border-color:var(--accent)!important;font-weight:700; }
.primary-action:hover { background:#ffb1a8; }
.secondary-action:hover { border-color:var(--accent); }
.system-panel { min-width:0;width:100%;max-width:560px;justify-self:end; }
.workspace { padding:var(--section-space) 0; }
.workspace-heading { display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px; }
.workspace-heading h2 { margin:8px 0 0;font-size:clamp(1.5rem,3vw,2.2rem);line-height:1.2;letter-spacing:-.04em; }
.workspace-heading>span { color:var(--muted);font-size:.75rem;white-space:nowrap; }
.project-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:20px; }
.project-link { display:block;color:inherit;text-decoration:none; }
.project-content { position:relative;display:flex;flex-direction:column;min-height:200px; }
.project-index { position:absolute;right:0;top:0;color:rgba(255,139,131,.12);font-size:3.5rem;line-height:1; }
.project-content h3 { position:relative;margin:14px 0 12px;font-size:clamp(1.6rem,3vw,2.25rem);letter-spacing:-.04em; }
.description { max-width:640px;margin:0 0 24px;color:var(--muted);font:1rem/1.7 Arial,Helvetica,sans-serif; }
.project-meta { display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-top:auto;padding-top:18px;border-top:1px solid var(--border);font-size:.72rem;color:var(--muted); }
footer { display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding:24px 0 32px;border-top:1px solid var(--border);font-size:.7rem;color:var(--muted); }
@media(max-width:800px) { .hero { grid-template-columns:1fr; } .system-panel { max-width:600px;justify-self:start; } }
@media(max-width:480px) { .workspace-heading { flex-direction:column;align-items:flex-start;gap:10px; } .hero-actions a { flex:1 1 auto; } }

</style>
