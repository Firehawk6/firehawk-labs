---
import BaseLayout from "../layouts/BaseLayout.astro";
import DesktopLauncher from "../components/DesktopLauncher.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Firehawk Labs">
  <div class="system-shell">
    <header class="topbar">
      <a class="brand" href="/">
        <span class="brand-mark">F6</span>

        <span>
          <strong>FIREHAWK LABS</strong>
          <small>REMOTE SYSTEM INTERFACE</small>
        </span>
      </a>

      <nav>
        <a href="#projects">PROJECTS</a>
        <a href="/experiments">EXPERIMENTS</a>
        <a href="/terminal">TERMINAL</a>

        <a
          href="https://github.com/Firehawk6"
          target="_blank"
          rel="noopener noreferrer"
        >
          GITHUB ↗
        </a>
      </nav>

      <div class="system-status">
        <span class="status-light"></span>
        ONLINE
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">&gt; CONNECTED TO FIREHAWK-LABS</p>

          <h1>
            BUILDING
            <span>STRANGE THINGS</span>
            ON PURPOSE.
          </h1>

          <p class="intro">
            A digital workshop for infrastructure, experiments, automation,
            web interfaces, games, and ideas that were too interesting not to
            build.
          </p>

          <div class="hero-actions">
            <a class="primary-action" href="#projects">
              OPEN PROJECT ARCHIVE
            </a>

            <a class="secondary-action" href="/terminal">
              LAUNCH TERMINAL
            </a>
          </div>
        </div>

        <aside class="system-panel">
          <div class="panel-header">
            <span>SYSTEM OVERVIEW</span>
            <span>LIVE</span>
          </div>

          <dl>
            <div>
              <dt>HOST</dt>
              <dd>FIREHAWK-LABS</dd>
            </div>

            <div>
              <dt>STATUS</dt>
              <dd class="online">ONLINE</dd>
            </div>

            <div>
              <dt>PROJECTS</dt>
              <dd>{String(projects.length).padStart(2, "0")}</dd>
            </div>

            <div>
              <dt>MODE</dt>
              <dd>EXPERIMENTAL</dd>
            </div>

            <div>
              <dt>UPLINK</dt>
              <dd>SECURE</dd>
            </div>
          </dl>

          <div class="activity">
            <span>RECENT ACTIVITY</span>
            <p>&gt; Interface initialized</p>
            <p>&gt; Project archive mounted</p>
            <p>&gt; GitHub uplink available</p>
            <p class="cursor-line">&gt; Awaiting input<span>_</span></p>
          </div>
        </aside>
      </section>

      <DesktopLauncher />

      <section class="workspace" id="projects">
        <div class="workspace-heading">
          <div>
            <p class="eyebrow">DIRECTORY / PROJECTS</p>
            <h2>PROJECT ARCHIVE</h2>
          </div>

          <span>
            {String(projects.length).padStart(2, "0")} NODES AVAILABLE
          </span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <a
                class="project-window"
                href={`/projects/${project.slug}`}
              >
                <div class="window-bar">
                  <span>
                    PROJECT_{String(index + 1).padStart(3, "0")}
                  </span>

                  <div class="window-controls">
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>

                <div class="window-content">
                  <div class="project-index">
                    {String(index + 1).padStart(2, "0")}
                  </div>

                  <p class="category">{project.category}</p>
                  <h3>{project.title}</h3>

                  <p class="description">
                    {project.description}
                  </p>

                  <div class="project-meta">
                    <span>
                      STATUS: {project.status.toUpperCase()}
                    </span>

                    <span>OPEN NODE ↗</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer>
      <span>FIREHAWK LABS / SYSTEM BUILD 2026.07</span>
      <span>labs.firehawk6.com</span>
    </footer>
  </div>

  <div class="cursor-glow"></div>
  <div class="scanlines"></div>

  <script>
    import gsap from "gsap";

    const glow = document.querySelector(".cursor-glow");

    window.addEventListener("mousemove", (event) => {
      if (!(glow instanceof HTMLElement)) return;

      glow.animate(
        {
          left: `${event.clientX}px`,
          top: `${event.clientY}px`,
        },
        {
          duration: 500,
          fill: "forwards",
        }
      );
    });

    const animateInterface = () => {
      gsap.set(".topbar", {
        opacity: 0,
        y: -24,
      });

      gsap.set(".hero-copy > *", {
        opacity: 0,
        y: 24,
      });

      gsap.set(".system-panel", {
        opacity: 0,
        x: 36,
      });

      gsap.set(".desktop-launcher", {
        opacity: 0,
        y: 30,
      });

      gsap.set(".app-tile", {
        opacity: 0,
        y: 24,
        scale: 0.98,
      });

      gsap.set(".workspace-heading", {
        opacity: 0,
        y: 24,
      });

      gsap.set(".project-window", {
        opacity: 0,
        y: 36,
        scale: 0.98,
      });

      gsap.set("footer", {
        opacity: 0,
        y: 20,
      });

      const timeline = gsap.timeline({
        defaults: {
          ease: "power3.out",
        },
      });

      timeline
        .to(".topbar", {
          opacity: 1,
          y: 0,
          duration: 0.7,
        })
        .to(
          ".hero-copy > *",
          {
            opacity: 1,
            y: 0,
            duration: 0.75,
            stagger: 0.1,
          },
          "-=0.35"
        )
        .to(
          ".system-panel",
          {
            opacity: 1,
            x: 0,
            duration: 0.8,
          },
          "-=0.55"
        )
        .to(
          ".desktop-launcher",
          {
            opacity: 1,
            y: 0,
            duration: 0.65,
          },
          "-=0.3"
        )
        .to(
          ".app-tile",
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.55,
            stagger: 0.08,
          },
          "-=0.35"
        )
        .to(
          ".workspace-heading",
          {
            opacity: 1,
            y: 0,
            duration: 0.65,
          },
          "-=0.25"
        )
        .to(
          ".project-window",
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.75,
            stagger: 0.12,
          },
          "-=0.35"
        )
        .to(
          "footer",
          {
            opacity: 1,
            y: 0,
            duration: 0.55,
          },
          "-=0.2"
        );
    };

    window.addEventListener("firehawk:entered", animateInterface);

    if (sessionStorage.getItem("firehawk-booted") === "true") {
      animateInterface();
    }
  </script>
</BaseLayout>

<style>
  .system-shell {
    position: relative;
    z-index: 2;
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
  }

  .topbar {
    position: sticky;
    z-index: 20;
    top: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 86px;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 9, 8, 0.84);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    width: fit-content;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--green);
    color: var(--green);
    font-weight: 700;
    box-shadow: inset 0 0 18px rgba(109, 255, 155, 0.06);
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    color: var(--text);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
  }

  .brand small {
    margin-top: 5px;
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
  }

  nav {
    display: flex;
    gap: 30px;
  }

  nav a {
    color: var(--muted);
    font-size: 0.69rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  nav a:hover {
    color: var(--green);
  }

  .system-status {
    justify-self: end;
    color: var(--muted);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
  }

  .status-light {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 14px var(--green);
  }

  .hero {
    display: grid;
    min-height: calc(100vh - 86px);
    grid-template-columns: minmax(0, 1.6fr) minmax(300px, 0.7fr);
    align-items: center;
    gap: clamp(50px, 8vw, 140px);
    padding: 100px 0;
  }

  .eyebrow,
  .category {
    color: var(--green);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
  }

  h1 {
    max-width: 1050px;
    margin: 24px 0 0;
    font-size: clamp(4rem, 8vw, 8.6rem);
    line-height: 0.82;
    letter-spacing: -0.075em;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1px var(--muted);
  }

  .intro {
    max-width: 700px;
    margin: 42px 0 0;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .hero-actions a {
    padding: 17px 20px;
    border: 1px solid var(--border);
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .hero-actions a:hover {
    transform: translateY(-2px);
  }

  .primary-action {
    border-color: var(--green) !important;
    color: var(--green);
  }

  .primary-action:hover {
    background: var(--green);
    color: var(--background);
  }

  .secondary-action {
    color: var(--muted);
  }

  .secondary-action:hover {
    border-color: var(--green);
    color: var(--green);
  }

  .system-panel {
    border: 1px solid var(--border);
    background: rgba(13, 18, 16, 0.8);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3);
  }

  .panel-header,
  .window-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 42px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .system-panel dl {
    margin: 0;
    padding: 10px 18px;
  }

  .system-panel dl div {
    display: flex;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid rgba(32, 48, 40, 0.7);
  }

  .system-panel dt,
  .system-panel dd {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .system-panel dt {
    color: var(--muted);
  }

  .system-panel dd {
    color: var(--text);
  }

  .system-panel .online {
    color: var(--green);
  }

  .activity {
    padding: 22px 18px 24px;
  }

  .activity > span {
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .activity p {
    margin: 13px 0 0;
    color: var(--muted);
    font-size: 0.72rem;
  }

  .cursor-line span {
    color: var(--green);
    animation: blink 900ms steps(1) infinite;
  }

  .workspace {
    padding: 110px 0 150px;
  }

  .workspace-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 30px;
  }

  .workspace-heading h2 {
    margin: 10px 0 0;
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .workspace-heading > span {
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.11em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .project-window {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border);
    background: rgba(13, 18, 16, 0.76);
    text-decoration: none;
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.2);
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background 220ms ease;
  }

  .project-window:hover {
    transform: translateY(-8px);
    border-color: rgba(109, 255, 155, 0.65);
    background: var(--panel-hover);
  }

  .window-controls {
    display: flex;
    gap: 6px;
  }

  .window-controls i {
    width: 6px;
    height: 6px;
    border: 1px solid var(--muted);
    border-radius: 50%;
  }

  .window-content {
    position: relative;
    min-height: 340px;
    padding: 34px;
  }

  .project-index {
    position: absolute;
    top: 26px;
    right: 30px;
    color: rgba(109, 255, 155, 0.12);
    font-size: 5rem;
    font-weight: 700;
  }

  .window-content h3 {
    position: relative;
    margin: 18px 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .description {
    position: relative;
    max-width: 560px;
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.65;
  }

  .project-meta {
    position: absolute;
    right: 34px;
    bottom: 30px;
    left: 34px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.09em;
  }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding: 34px 0 44px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }

  .cursor-glow {
    position: fixed;
    z-index: 1;
    width: 560px;
    height: 560px;
    pointer-events: none;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(109, 255, 155, 0.07),
      transparent 67%
    );
  }

  .scanlines {
    position: fixed;
    z-index: 30;
    inset: 0;
    pointer-events: none;
    opacity: 0.1;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(255, 255, 255, 0.025) 4px
    );
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 980px) {
    .topbar {
      grid-template-columns: 1fr auto;
    }

    nav {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
    }

    .system-panel {
      max-width: 680px;
    }
  }

  @media (max-width: 720px) {
    .system-shell {
      width: min(100% - 24px, 1440px);
    }

    .brand small,
    .system-status {
      display: none;
    }

    .hero {
      min-height: auto;
      padding: 90px 0;
    }

    h1 {
      font-size: clamp(3.3rem, 17vw, 6rem);
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .workspace-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-meta,
    footer {
      flex-direction: column;
    }

    .cursor-glow {
      display: none;
    }
  }
</style>
