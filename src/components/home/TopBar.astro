---
import StatusLight from "../ui/StatusLight.astro";
---

<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark">F6</span>

    <span>
      <strong>FIREHAWK LABS</strong>
      <small>REMOTE SYSTEM INTERFACE</small>
    </span>
  </a>

  <nav>
    <a href="#projects">PROJECTS</a>
    <a href="/experiments">EXPERIMENTS</a>
    <a href="/terminal">TERMINAL</a>

    <a
      href="https://github.com/Firehawk6"
      target="_blank"
      rel="noopener noreferrer"
    >
      GITHUB ↗
    </a>
  </nav>

  <div class="status-wrapper">
    <StatusLight />
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    min-height: 86px;

    border-bottom: 1px solid var(--border);

    background: rgba(7,9,8,.84);
    backdrop-filter: blur(16px);
  }

  .brand{
    display:inline-flex;
    align-items:center;
    gap:14px;
    text-decoration:none;
    width:fit-content;
  }

  .brand-mark{
    display:grid;
    place-items:center;

    width:42px;
    height:42px;

    border:1px solid var(--green);

    color:var(--green);
    font-weight:700;

    box-shadow: inset 0 0 18px rgba(109,255,155,.06);
  }

  .brand strong,
  .brand small{
    display:block;
  }

  .brand strong{
    color:var(--text);
    font-size:.8rem;
    letter-spacing:.16em;
  }

  .brand small{
    margin-top:5px;
    color:var(--muted);
    font-size:.58rem;
    letter-spacing:.12em;
  }

  nav{
    display:flex;
    gap:30px;
  }

  nav a{
    color:var(--muted);
    text-decoration:none;
    font-size:.69rem;
    letter-spacing:.12em;
    transition:color .2s;
  }

  nav a:hover{
    color:var(--green);
  }

  .status-wrapper{
    justify-self:end;
  }

  @media (max-width:980px){

    .topbar{
      grid-template-columns:1fr auto;
    }

    nav{
      display:none;
    }

  }

  @media (max-width:720px){

    .brand small{
      display:none;
    }

    .status-wrapper{
      display:none;
    }

  }
</style>
