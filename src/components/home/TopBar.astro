---
import { navigation } from "../../data/navigation";
---

<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark">F6</span>

    <span>
      <strong>FIREHAWK LABS</strong>
      <small>BUILDING WHAT I WANT</small>
    </span>
  </a>

  <nav aria-label="Main navigation">
    {navigation.map(item => <a href={item.href} aria-current={Astro.url.pathname.replace(/\/$/, "") === item.href ? "page" : undefined}>{item.name.toUpperCase()}</a>)}
  </nav>


</header>

<style>

.topbar { position:relative;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:82px;padding:16px 0;border-bottom:1px solid var(--border);background:transparent; }
.brand { display:inline-flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0; }
.brand-mark { display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--accent);color:var(--accent);font-weight:700; }
.brand strong,.brand small { display:block; }
.brand strong { font-size:.85rem;letter-spacing:.1em; }
.brand small { margin-top:3px;color:var(--muted);font-size:.62rem;letter-spacing:.06em; }
nav { display:flex;flex-wrap:wrap;gap:4px; }
nav a { display:flex;align-items:center;min-height:42px;padding:8px 12px;border:1px solid transparent;text-decoration:none;font-size:.72rem;color:var(--muted); }
nav a:hover,nav a[aria-current="page"] { color:var(--accent);background:rgba(255,139,131,.045);border-color:var(--border); }
@media(max-width:850px) { .topbar { position:relative;flex-wrap:wrap;gap:12px; } nav { width:100%; } nav a { padding:8px 10px; } }
@media(max-width:420px) { nav { display:grid;grid-template-columns:repeat(2,minmax(0,1fr)); } nav a { justify-content:center;border-color:var(--border); } }

</style>
