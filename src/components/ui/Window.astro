---
import StatusLight from "./StatusLight.astro";

interface Props {
  title: string;
  status?: "online" | "warning" | "offline";
}

const {
  title,
  status = "online",
} = Astro.props;
---

<div class="window">
  <div class="window-bar">
    <div class="window-left">
      <div class="traffic">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <span class="window-title">
        {title}
      </span>
    </div>

    <StatusLight
      status={status}
      label={status.toUpperCase()}
    />
  </div>

  <div class="window-content">
    <slot />
  </div>
</div>

<style>
.window{
    overflow:hidden;
    border:1px solid var(--border);
    background:rgba(13,18,16,.78);

    box-shadow:
        0 24px 70px rgba(0,0,0,.28);

    transition:
        transform .25s,
        border-color .25s,
        box-shadow .25s;
}

.window:hover{

    transform:translateY(-8px);

    border-color:rgba(109,255,155,.55);

    box-shadow:
        0 40px 120px rgba(0,0,0,.35);

}

.window-bar{

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:14px 18px;

    border-bottom:1px solid var(--border);

    background:rgba(255,255,255,.015);

}

.window-left{

    display:flex;
    align-items:center;
    gap:14px;

}

.traffic{

    display:flex;
    gap:6px;

}

.traffic span{

    width:7px;
    height:7px;

    border-radius:50%;

    background:var(--muted);

    opacity:.45;

}

.window-title{

    color:var(--muted);

    font-size:.68rem;

    letter-spacing:.12em;

}

.window-content{

    padding:30px;

}
</style>
