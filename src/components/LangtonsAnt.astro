---
---
<section class="ant-lab" id="ant-lab" aria-label="Langton's ant simulator">
  <div class="toolbar">
    <span class="tag">SIMULATION / 01</span>
    <span id="ant-state" role="status">Ready — press Play to begin</span>
  </div>
  <div class="lab-grid">
    <div class="viewport">
      <canvas id="ant-canvas" tabindex="0" aria-label="Ant simulation. Drag to pan, use zoom buttons to zoom. Arrow keys pan when focused.">
        Your browser needs canvas support to display the simulation.
      </canvas>
      <div class="view-controls" aria-label="View controls">
        <button id="ant-out" aria-label="Zoom out">−</button>
        <button id="ant-center">Center</button>
        <button id="ant-in" aria-label="Zoom in">+</button>
      </div>
      <div class="canvas-hint">DRAG TO EXPLORE · SCROLL TO ZOOM</div>
    </div>
    <aside class="controls" aria-label="Simulation controls">
      <p class="section-label">SMALL RULES. UNEXPECTED PATTERNS.</p>
      <div class="transport">
        <button id="ant-play" class="primary" disabled>Play</button>
        <button id="ant-step" disabled>Step</button>
        <button id="ant-reset" disabled>Reset</button>
      </div>
      <label for="ant-speed">Speed <output id="ant-speed-value">600 ticks/s</output></label>
      <input id="ant-speed" type="range" min="0" max="4" step="1" value="2" />
      <p class="hint">One tick moves every ant once. Actual speed adapts to your device.</p>
      <label for="ant-theme">Palette</label>
      <select id="ant-theme">
        <option value="labs">Firehawk</option><option value="classic">Classic</option>
        <option value="neon">Neon</option><option value="minic">Minic119's</option><option value="jerm">JermQ's</option>
      </select>
      <div class="settings">
        <label for="ant-count">Starting ants</label>
        <input id="ant-count" type="number" min="1" max="100" value="1" />
        <label class="check"><input id="ant-spawn" type="checkbox" /> Spawn on collisions</label>
        <label for="ant-cap">Ant limit</label>
        <input id="ant-cap" type="number" min="1" max="1500" value="1500" />
        <button id="ant-apply">Apply & restart</button>
        <p class="hint">Starting ants and collision settings take effect when applied. Up to 1,500 ants. At the ant limit, existing ants keep moving; collisions stop spawning new ants.</p>
      </div>
      <label class="check"><input id="ant-follow" type="checkbox" /> Follow first ant</label>
      <button id="ant-save">Save image</button>
    </aside>
  </div>
  <dl class="stats">
    <div><dt>Ticks</dt><dd id="ant-ticks">0</dd></div>
    <div><dt>Ants</dt><dd id="ant-total">1</dd></div>
    <div><dt>Active cells</dt><dd id="ant-cells">0</dd></div>
    <div><dt>Actual ticks/s</dt><dd id="ant-rate">0</dd></div>
  </dl>
  <noscript><p>Enable JavaScript to run this simulation.</p></noscript>
</section>
<div class="explanation">
  <div><span class="section-label">HOW IT WORKS</span><h2>Two rules. A world of patterns.</h2></div>
  <p>On an empty cell, turn right. On a filled cell, turn left. Flip the cell, then move forward. Start with one ant to see the classic behavior, or add more and enable collision spawning to explore the variation from my original project.</p>
  <p>Each visitor gets their own simulation. It pauses when the tab is hidden or the canvas is offscreen. Long runs pause at the memory limit; reset to start again. Reloading clears the simulation.</p>
</div>
<script>
  import "../scripts/langtons-ant.js";
</script>
<style>
.ant-lab { border:1px solid var(--border);background:var(--panel);border-radius:12px;overflow:hidden; }
.toolbar { display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid var(--border);font-size:.75rem;color:var(--muted); }
.tag,.section-label { color:var(--accent);font-size:.7rem;letter-spacing:.09em; }
.lab-grid { display:grid;grid-template-columns:minmax(0,1fr) 280px; }
.viewport { position:relative;min-width:0;height:clamp(380px,65vh,760px);background:#0b0b0d; }
canvas { display:block;width:100%;height:100%;touch-action:none;cursor:grab; }
canvas:active { cursor:grabbing; }
.controls { padding:22px;border-left:1px solid var(--border);display:flex;flex-direction:column;gap:12px; }
.controls p { margin:0; }
.transport { display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:6px; }
button,select,input[type=number] { min-height:42px;border:1px solid #594046;border-radius:6px;background:#211a1d;color:var(--text);padding:8px 10px;font:inherit;font-size:.8rem; }
button { cursor:pointer; }
button:hover { border-color:var(--accent);background:#352428; }
button:disabled { opacity:.45;cursor:default; }
.primary { background:var(--accent);color:#170d10;font-weight:bold; }
.primary:hover { background:#ffb1a8; }
label { font-size:.8rem;color:var(--text);display:flex;justify-content:space-between;gap:10px; }
output { color:var(--accent);font-size:.75rem; }
select,input[type=number] { width:100%; }
input[type=range] { width:100%;accent-color:var(--accent); }
input[type=checkbox] { accent-color:var(--accent);width:18px;height:18px; }
.check { justify-content:flex-start;align-items:center;min-height:34px; }
.hint { font: .75rem/1.6 Arial,sans-serif;color:var(--muted); }
.settings { display:grid;gap:9px;border-top:1px solid var(--border);padding-top:16px;margin-top:4px; }
.view-controls { position:absolute;left:16px;top:16px;display:flex;gap:6px; }
.view-controls button { background:#171114e8; }
.canvas-hint { position:absolute;bottom:16px;left:16px;color:#c3b2b6;font-size:.65rem;pointer-events:none;background:#100d10dd;padding:5px 8px;border-radius:4px; }
.stats { margin:0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border); }
.stats>div { padding:18px 22px; }
dt { color:var(--muted);font-size:.7rem; }
dd { margin:5px 0 0;font-size:clamp(1.1rem,2vw,1.6rem);font-variant-numeric:tabular-nums;overflow-wrap:anywhere; }
.explanation { display:grid;grid-template-columns:1fr 1fr 1fr;gap:28px;margin:36px 0; }
.explanation h2 { font-size:1.4rem;margin:10px 0; }
.explanation p { color:var(--muted);font: .95rem/1.8 Arial,sans-serif;margin:0; }
@media(max-width:850px) { .lab-grid { grid-template-columns:1fr; }.controls { border-left:0;border-top:1px solid var(--border); }.viewport { height:52vh;min-height:340px; }.explanation { grid-template-columns:1fr;gap:16px; } }
@media(max-width:480px) { .stats { grid-template-columns:1fr 1fr; }.stats>div { padding:14px; }.toolbar { padding:14px; } }
</style>
