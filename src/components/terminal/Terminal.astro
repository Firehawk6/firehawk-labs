<div class="terminal-window">
  <div class="terminal-bar">
    <span>FIREHAWK TERMINAL</span>
    <span>SESSION ACTIVE</span>
  </div>

  <div class="terminal-output" id="terminal-output">
    <p><span class="prompt">firehawk@labs:~$</span> welcome</p>
    <p>Type <strong>help</strong> to see available commands.</p>
  </div>

  <form class="terminal-form" id="terminal-form">
    <label for="terminal-input">firehawk@labs:~$</label>

    <input
      id="terminal-input"
      name="command"
      type="text"
      autocomplete="off"
      spellcheck="false"
      autofocus
    />
  </form>
</div>

<script>
  import { navigation } from "../../data/navigation";
  const form = document.querySelector("#terminal-form");
  const input = document.querySelector("#terminal-input");
  const output = document.querySelector("#terminal-output");

  const commands: Record<string, () => string> = {
    help: () =>
      [
        "Available commands:",
        "help        Show this command list",
        ...navigation.map(item => `${item.command.padEnd(12)}Open ${item.name}`),
        "about       About Firehawk Labs",
        "clear       Clear the terminal",
      ].join("\n"),

    about: () =>
      "Firehawk Labs is a digital workshop for personal projects, infrastructure, automation, and things I’m building.",


  };

  const appendLine = (text: string, className = "") => {
    if (!(output instanceof HTMLElement)) return;

    const line = document.createElement("pre");
    line.textContent = text;

    if (className) {
      line.className = className;
    }

    output.appendChild(line);
    output.scrollTop = output.scrollHeight;
  };

  if (
    form instanceof HTMLFormElement &&
    input instanceof HTMLInputElement &&
    output instanceof HTMLElement
  ) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const command = input.value.trim();
      const normalized = command.toLowerCase();

      appendLine(`firehawk@labs:~$ ${command}`, "command-line");

      if (!command) {
        input.value = "";
        return;
      }

      if (normalized === "clear") {
        output.innerHTML = "";
      } else if (navigation.some(item => item.command === normalized)) {
        const destination = navigation.find(item => item.command === normalized)!;
        appendLine(`Opening ${destination.name}...`);
        window.location.href = destination.href;
      } else if (Object.hasOwn(commands, normalized)) {
        appendLine(commands[normalized]());
      } else {
        appendLine(
          `Command not found: ${command}\nType "help" for available commands.`,
          "error-line"
        );
      }

      input.value = "";
    });

    document
      .querySelector(".terminal-window")
      ?.addEventListener("click", () => input.focus());
  }
</script>

<style>
  .terminal-window {
    overflow: hidden;
    border: 1px solid var(--border);
    background: rgba(8, 12, 10, 0.94);
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.45);
  }

  .terminal-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
  }

  .terminal-output {
    min-height: 430px;
    max-height: 60vh;
    overflow-y: auto;
    padding: 24px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .terminal-output p,
  .terminal-output pre {
    margin: 0 0 10px;
    white-space: pre-wrap;
  }

  .prompt,
  .terminal-output strong,
  :global(.command-line) {
    color: var(--green);
  }

  :global(.error-line) {
    color: #ff5f6d;
  }

  .terminal-form {
    display: flex;
    gap: 10px;
    padding: 18px 24px;
    border-top: 1px solid var(--border);
  }

  .terminal-form label {
    color: var(--green);
    white-space: nowrap;
  }

  .terminal-form input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    caret-color: var(--green);
  }

  @media (max-width: 720px) {
    .terminal-output {
      min-height: 360px;
    }

    .terminal-form {
      overflow-x: auto;
    }
  }
</style>
