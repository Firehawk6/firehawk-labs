<div class="background-scene" aria-hidden="true">
  <canvas id="background-canvas"></canvas>
</div>

<script>
  import * as THREE from "three";

  const canvas = document.querySelector("#background-canvas");

  if (canvas instanceof HTMLCanvasElement) {
    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      55,
      window.innerWidth / window.innerHeight,
      0.1,
      100
    );

    camera.position.set(0, 5.5, 10);
    camera.rotation.x = -0.45;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: "high-performance",
    });

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(window.innerWidth, window.innerHeight);

    const grid = new THREE.GridHelper(
      45,
      45,
      0x6dff9b,
      0x203028
    );

    grid.material.transparent = true;
    grid.material.opacity = 0.16;

    scene.add(grid);

    const particleGeometry = new THREE.BufferGeometry();
    const particleCount = 140;
    const positions = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 32;
      positions[i * 3 + 1] = Math.random() * 12 - 1;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 32;
    }

    particleGeometry.setAttribute(
      "position",
      new THREE.BufferAttribute(positions, 3)
    );

    const particleMaterial = new THREE.PointsMaterial({
      color: 0x6dff9b,
      size: 0.035,
      transparent: true,
      opacity: 0.4,
      sizeAttenuation: true,
    });

    const particles = new THREE.Points(
      particleGeometry,
      particleMaterial
    );

    scene.add(particles);

    const mouse = {
      x: 0,
      y: 0,
    };

    const target = {
      x: 0,
      y: 0,
    };

    window.addEventListener("mousemove", (event) => {
      target.x = (event.clientX / window.innerWidth - 0.5) * 0.8;
      target.y = (event.clientY / window.innerHeight - 0.5) * 0.35;
    });

    const clock = new THREE.Clock();

    const animate = () => {
      const elapsed = clock.getElapsedTime();

      mouse.x += (target.x - mouse.x) * 0.025;
      mouse.y += (target.y - mouse.y) * 0.025;

      camera.position.x = mouse.x;
      camera.position.y = 5.5 - mouse.y;

      grid.position.z = (elapsed * 0.35) % 1;
      particles.rotation.y = elapsed * 0.015;
      particles.position.y = Math.sin(elapsed * 0.25) * 0.15;

      renderer.render(scene, camera);
      requestAnimationFrame(animate);
    };

    animate();

    window.addEventListener("resize", () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();

      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(
        Math.min(window.devicePixelRatio, 1.5)
      );
    });
  }
</script>

<style>
  .background-scene {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #background-canvas {
    width: 100%;
    height: 100%;
    opacity: 0.58;
  }

  .background-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 35%,
        transparent 0,
        rgba(7, 9, 8, 0.2) 42%,
        rgba(7, 9, 8, 0.92) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(7, 9, 8, 0.15),
        rgba(7, 9, 8, 0.8)
      );
  }

  @media (prefers-reduced-motion: reduce) {
    #background-canvas {
      opacity: 0.25;
    }
  }
</style>
