<div class="background-scene" aria-hidden="true">
  <canvas id="background-canvas"></canvas>
</div>

<script>
  const canvas = document.querySelector("#background-canvas");

  if (canvas instanceof HTMLCanvasElement) {
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    if (reduceMotion.matches) {
      canvas.hidden = true;
    } else {
      let disposed = false;
      let cleanup = () => {};

      const initializeScene = async () => {
        try {
          const {
            BufferAttribute,
            BufferGeometry,
            Clock,
            CanvasTexture,
            GridHelper,
            PerspectiveCamera,
            Points,
            PointsMaterial,
            Scene,
            WebGLRenderer,
          } = await import("three");

          if (disposed) return;

          const scene = new Scene();

          const camera = new PerspectiveCamera(
            55,
            window.innerWidth / window.innerHeight,
            0.1,
            100
          );

          camera.position.set(0, 5.5, 10);
          camera.rotation.x = -0.45;

          const renderer = new WebGLRenderer({
            canvas,
            alpha: true,
            antialias: true,
            powerPreference: "high-performance",
          });

          renderer.setPixelRatio(
            Math.min(window.devicePixelRatio, 2)
          );

          renderer.setSize(
            window.innerWidth,
            window.innerHeight
          );

          const grid = new GridHelper(
            45,
            45,
            0xff8b83,
            0x393236
          );

          const gridMaterials = Array.isArray(grid.material)
            ? grid.material
            : [grid.material];

          for (const material of gridMaterials) {
            material.transparent = true;
            material.opacity = 0.14;
          }

          scene.add(grid);

          const particleGeometry = new BufferGeometry();
          const particleCount = 140;
          const positions = new Float32Array(
            particleCount * 3
          );

          for (
            let index = 0;
            index < particleCount;
            index++
          ) {
            positions[index * 3] =
              (Math.random() - 0.5) * 32;

            positions[index * 3 + 1] =
              Math.random() * 12 - 1;

            positions[index * 3 + 2] =
              (Math.random() - 0.5) * 32;
          }

          particleGeometry.setAttribute(
            "position",
            new BufferAttribute(positions, 3)
          );

          // A soft circular sprite avoids the default square point appearance.
          const sprite = document.createElement("canvas");
          sprite.width = sprite.height = 64;
          const context = sprite.getContext("2d");
          if (!context) throw new Error("Particle texture context unavailable");
          const gradient = context.createRadialGradient(32, 32, 0, 32, 32, 32);
          gradient.addColorStop(0, "rgba(255,255,255,1)");
          gradient.addColorStop(0.25, "rgba(255,255,255,0.8)");
          gradient.addColorStop(1, "rgba(255,255,255,0)");
          context.fillStyle = gradient;
          context.fillRect(0, 0, 64, 64);
          const particleTexture = new CanvasTexture(sprite);

          const particleMaterial = new PointsMaterial({
            color: 0xff8b83,
            size: 0.045,
            map: particleTexture,
            depthWrite: false,
            transparent: true,
            opacity: 0.4,
            sizeAttenuation: true,
          });

          const particles = new Points(
            particleGeometry,
            particleMaterial
          );

          scene.add(particles);

          const currentMouse = {
            x: 0,
            y: 0,
          };

          const targetMouse = {
            x: 0,
            y: 0,
          };

          const handleMouseMove = (event: MouseEvent) => {
            targetMouse.x =
              (event.clientX / window.innerWidth - 0.5) *
              0.8;

            targetMouse.y =
              (event.clientY / window.innerHeight - 0.5) *
              0.35;
          };

          const handleResize = () => {
            camera.aspect =
              window.innerWidth / window.innerHeight;

            camera.updateProjectionMatrix();

            renderer.setPixelRatio(
              Math.min(window.devicePixelRatio, 2)
            );

            renderer.setSize(
              window.innerWidth,
              window.innerHeight
            );
          };

          window.addEventListener(
            "mousemove",
            handleMouseMove,
            { passive: true }
          );

          window.addEventListener(
            "resize",
            handleResize,
            { passive: true }
          );

          const clock = new Clock();

          let animationFrame = 0;
          let running = true;

          const renderFrame = () => {
            if (!running) return;

            const delta = clock.getDelta();
            const elapsed = clock.elapsedTime;
            const follow = 1 - Math.exp(-22 * delta);

            currentMouse.x +=
              (targetMouse.x - currentMouse.x) * follow;

            currentMouse.y +=
              (targetMouse.y - currentMouse.y) * follow;

            camera.position.x = currentMouse.x;
            camera.position.y = 5.5 - currentMouse.y;

            grid.position.z = (elapsed * 0.35) % 1;
            particles.rotation.y = elapsed * 0.015;

            particles.position.y =
              Math.sin(elapsed * 0.25) * 0.15;

            renderer.render(scene, camera);

            animationFrame =
              window.requestAnimationFrame(renderFrame);
          };

          const handleVisibilityChange = () => {
            if (document.hidden) {
              running = false;

              window.cancelAnimationFrame(
                animationFrame
              );
            } else if (!running) {
              running = true;
              clock.start();
              renderFrame();
            }
          };

          document.addEventListener(
            "visibilitychange",
            handleVisibilityChange
          );

          renderFrame();

          cleanup = () => {
            running = false;

            window.cancelAnimationFrame(animationFrame);

            window.removeEventListener(
              "mousemove",
              handleMouseMove
            );

            window.removeEventListener(
              "resize",
              handleResize
            );

            document.removeEventListener(
              "visibilitychange",
              handleVisibilityChange
            );

            particleGeometry.dispose();
            particleTexture.dispose();
            grid.geometry.dispose();
            particleMaterial.dispose();

            for (const material of gridMaterials) {
              material.dispose();
            }

            renderer.dispose();
          };
        } catch (error) {
          console.error(
            "Unable to initialize background scene:",
            error
          );

          canvas.hidden = true;
        }
      };

      const startTimer = window.setTimeout(() => {
        void initializeScene();
      }, 0);

      window.addEventListener(
        "pagehide",
        () => {
          disposed = true;
          window.clearTimeout(startTimer);
          cleanup();
        },
        { once: true }
      );
    }
  }
</script>

<style>
  .background-scene {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  #background-canvas {
    width: 100%;
    height: 100%;
    opacity: 0.58;
  }

  .background-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 35%,
        transparent 0,
        rgba(11,11,13, 0.2) 42%,
        rgba(11,11,13, 0.92) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(11,11,13, 0.15),
        rgba(11,11,13, 0.8)
      );
  }

  @media (prefers-reduced-motion: reduce) {
    #background-canvas {
      display: none;
    }
  }
</style>
