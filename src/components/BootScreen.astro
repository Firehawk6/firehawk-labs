<div class="boot-screen" id="boot-screen">
  <div class="boot-frame">
    <div class="boot-header">
      <div class="boot-logo">F6</div>

      <div>
        <p class="boot-title">FIREHAWK LABS</p>
        <p class="boot-subtitle">REMOTE SYSTEM INTERFACE</p>
      </div>

      <span class="boot-version">BUILD 2026.07</span>
    </div>

    <div class="boot-terminal">
      <div class="boot-line">
        <span>&gt; Resolving labs.firehawk6.com</span>
        <strong>OK</strong>
      </div>

      <div class="boot-line">
        <span>&gt; Negotiating secure connection</span>
        <strong>OK</strong>
      </div>

      <div class="boot-line">
        <span>&gt; Authenticating remote session</span>
        <strong>OK</strong>
      </div>

      <div class="boot-line">
        <span>&gt; Mounting project archive</span>
        <strong>OK</strong>
      </div>

      <div class="boot-line">
        <span>&gt; Loading interface modules</span>
        <strong>OK</strong>
      </div>

      <div class="boot-line">
        <span>&gt; Initializing 3D environment</span>
        <strong>OK</strong>
      </div>

      <div class="boot-line">
        <span>&gt; Verifying GitHub uplink</span>
        <strong>OK</strong>
      </div>

      <div class="boot-ready">
        <span>&gt; SYSTEM READY</span>
        <span class="cursor">_</span>
      </div>
    </div>

    <button id="enter-system" type="button">
      ENTER SYSTEM
    </button>
  </div>
</div>

<script>
  import gsap from "gsap";

  const bootScreen = document.querySelector("#boot-screen");
  const enterButton = document.querySelector("#enter-system");
  const lines = gsap.utils.toArray<HTMLElement>(".boot-line");
  const ready = document.querySelector(".boot-ready");

  if (
    bootScreen instanceof HTMLElement &&
    enterButton instanceof HTMLButtonElement &&
    ready instanceof HTMLElement
  ) {
    const alreadyBooted =
      sessionStorage.getItem("firehawk-booted") === "true";

    if (alreadyBooted) {
      bootScreen.remove();
      document.body.classList.remove("booting");
    } else {
      document.body.classList.add("booting");

      gsap.set(lines, {
        opacity: 0,
        x: -8,
      });

      gsap.set(
        lines.map((line) => line.querySelector("strong")),
        {
          opacity: 0,
          scale: 0.8,
        }
      );

      gsap.set(ready, {
        opacity: 0,
      });

      gsap.set(enterButton, {
        opacity: 0,
        y: 12,
        pointerEvents: "none",
      });

      const timeline = gsap.timeline({
        defaults: {
          ease: "power2.out",
        },
      });

      timeline
        .from(".boot-frame", {
          opacity: 0,
          scale: 0.97,
          duration: 0.5,
        })
        .from(
          ".boot-header",
          {
            opacity: 0,
            y: -10,
            duration: 0.35,
          },
          "-=0.2"
        );

      lines.forEach((line) => {
        const status = line.querySelector("strong");

        timeline
          .to(line, {
            opacity: 1,
            x: 0,
            duration: 0.22,
          })
          .to(
            status,
            {
              opacity: 1,
              scale: 1,
              duration: 0.18,
            },
            "+=0.08"
          );
      });

      timeline
        .to(ready, {
          opacity: 1,
          duration: 0.3,
        })
        .to(enterButton, {
          opacity: 1,
          y: 0,
          duration: 0.4,
          pointerEvents: "auto",
        });

      enterButton.addEventListener("click", () => {
        sessionStorage.setItem("firehawk-booted", "true");

        gsap
          .timeline({
            onComplete: () => {
              bootScreen.remove();
              document.body.classList.remove("booting");

              window.dispatchEvent(
                new CustomEvent("firehawk:entered")
              );
            },
          })
          .to(".boot-frame", {
            scale: 1.04,
            opacity: 0,
            duration: 0.5,
            ease: "power3.in",
          })
          .to(
            bootScreen,
            {
              opacity: 0,
              duration: 0.45,
              ease: "power2.inOut",
            },
            "-=0.15"
          );
      });
    }
  }
</script>

<style>
  .boot-screen {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 40%,
        rgba(109, 255, 155, 0.08),
        transparent 32%
      ),
      #050706;
  }

  .boot-screen::before {
    content: "";
    position: absolute;
    inset: -50%;
    opacity: 0.08;
    background:
      linear-gradient(rgba(109, 255, 155, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(109, 255, 155, 0.08) 1px, transparent 1px);
    background-size: 42px 42px;
    transform: perspective(700px) rotateX(65deg) translateY(25%);
  }

  .boot-frame {
    position: relative;
    z-index: 2;
    width: min(680px, 100%);
    border: 1px solid var(--border);
    background: rgba(10, 14, 12, 0.96);
    box-shadow:
      0 40px 140px rgba(0, 0, 0, 0.65),
      inset 0 0 80px rgba(109, 255, 155, 0.025);
  }

  .boot-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 24px;
    border-bottom: 1px solid var(--border);
  }

  .boot-logo {
    display: grid;
    width: 54px;
    height: 54px;
    place-items: center;
    border: 1px solid var(--green);
    color: var(--green);
    font-weight: 700;
    box-shadow:
      inset 0 0 22px rgba(109, 255, 155, 0.08),
      0 0 22px rgba(109, 255, 155, 0.08);
  }

  .boot-title,
  .boot-subtitle {
    margin: 0;
  }

  .boot-title {
    color: var(--text);
    font-size: 0.92rem;
    letter-spacing: 0.18em;
  }

  .boot-subtitle {
    margin-top: 7px;
    color: var(--muted);
    font-size: 0.6rem;
    letter-spacing: 0.13em;
  }

  .boot-version {
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.11em;
  }

  .boot-terminal {
    padding: 28px 24px;
  }

  .boot-line,
  .boot-ready {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 10px 0;
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
  }

  .boot-line strong {
    color: var(--green);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
  }

  .boot-ready {
    justify-content: flex-start;
    margin-top: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--green);
  }

  .cursor {
    animation: blink 850ms steps(1) infinite;
  }

  #enter-system {
    width: calc(100% - 48px);
    margin: 0 24px 24px;
    padding: 15px 18px;
    border: 1px solid var(--green);
    background: transparent;
    color: var(--green);
    cursor: pointer;
    letter-spacing: 0.13em;
    transition:
      background 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  #enter-system:hover {
    background: var(--green);
    color: var(--background);
    box-shadow: 0 0 30px rgba(109, 255, 155, 0.16);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 620px) {
    .boot-header {
      grid-template-columns: auto 1fr;
    }

    .boot-version {
      display: none;
    }

    .boot-frame {
      max-height: calc(100vh - 30px);
      overflow-y: auto;
    }

    .boot-line {
      font-size: 0.65rem;
    }
  }
</style>
